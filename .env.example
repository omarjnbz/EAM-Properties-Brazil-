# Copy to .env.local (never committed) and fill in. On Vercel, add the same keys
# under Project → Settings → Environment Variables.

# Website chat assistant (Daniel), on OpenAI. Without the key the button stays hidden.
# OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to gpt-6-luna (OpenAI's cheapest current model).
OPENAI_MODEL=

# Optional. low (default) | medium | high.
OPENAI_REASONING=

# Optional. The site's public address, no trailing slash. Defaults to
# https://www.eam-global.lat; set it only when the site moves to another domain.
NEXT_PUBLIC_SITE_URL=

# Where form leads go (roadmap, contact, guide downloads): the Google Apps Script
# web app URL from scripts/leads-webhook.gs, or any CRM/Zapier/Make webhook that
# accepts JSON. Required in production: without it the forms send visitors to WhatsApp.
LEADS_WEBHOOK_URL=

# A long random string, also saved as SECRET in the Apps Script, so only the
# website can add rows to the leads Sheet.
LEADS_WEBHOOK_SECRET=

# Set to true only at launch, on the real domain. Until then every page is
# marked "noindex" so the draft (placeholders, stand-in photos) stays off Google.
SITE_INDEXABLE=

# The site's own booking calendar (/book): the founder's Google Calendar, through an
# OAuth client and a refresh token from his account (see "Booking calendar" in the
# README). Without them, production shows Google's booking page and your computer
# shows a preview with sample times.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Optional: another calendar than his main one.
GOOGLE_CALENDAR_ID=
