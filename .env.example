# Copy to .env.local (never committed) and fill in. On Vercel, add the same keys
# under Project → Settings → Environment Variables.

# Groq API key for the website chat assistant: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b. openai/gpt-oss-20b is faster and cheaper.
GROQ_MODEL=

# Optional. low | medium (default) | high. Medium keeps program lists and figures accurate.
GROQ_REASONING=
